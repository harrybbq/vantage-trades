# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NOTHING in this file may ever be prefixed VITE_ or NEXT_PUBLIC_. Those are
# bundled into public JavaScript. Broker credentials are server-side only.

# --- Ledger database -------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5432/vantage_trades

# --- Ledger base currency --------------------------------------------------
# The ledger is single-currency by design (see docs/LEDGER.md). Every account
# and posting uses this. Changing it after any entry exists is a migration,
# not a config change.
LEDGER_BASE_CURRENCY=GBP

# --- Broker (server-side only) ---------------------------------------------
# Not yet used - no broker adapter is implemented. Listed so the shape is
# obvious when one is. Paper trading only until the ledger reconciles.
BROKER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_PAPER=true

# --- Read-only reporting endpoint (the Vantage widget's token) -------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sent as a header, never a query string. Rotate to revoke.
REPORT_TOKEN=
