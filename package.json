{
  "name": "vantage-trades",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Trading agents app - allocation ledger and per-agent attribution",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "./scripts/db-reset.sh",
    "demo": "tsx src/jobs/demo.ts",
    "job:reconcile": "tsx src/jobs/daily-reconcile.ts",
    "dev:api": "AUTH_MODE=insecure-local tsx scripts/dev-server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "job:agents": "tsx src/jobs/run-agents.ts",
    "demo:agent": "tsx src/jobs/agent-demo.ts",
    "demo:research": "tsx src/jobs/research-demo.ts",
    "token:mint": "tsx src/jobs/report-token.ts mint",
    "token:list": "tsx src/jobs/report-token.ts list",
    "token:revoke": "tsx src/jobs/report-token.ts revoke"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
